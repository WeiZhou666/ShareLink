# ============================================================
# ShareLink 环境配置模板
# 复制为 .env.development / .env.production / .env.test 后按环境填写；
# 启动期由 config/env-loader.ts 做 zod 校验：必需键缺失/非法会拒绝启动并逐键列出
# ============================================================
PORT=3000
LOG_LEVEL=debug
# JWT 签名密钥（会话令牌 + 分享访问令牌共用），上线前务必换为强随机值（生产环境校验拒绝模板默认值）
JWT_SECRET=manage_jwt_secret_key
# cookie 是否仅限 https 传输（开发 false，生产必须 true——校验强制）
COOKIE_SECURE=false
# 跨域白名单，逗号分隔多个来源；不设置则放行所有来源（仅开发用，生产校验强制要求配置）
CORS_ORIGIN=http://localhost:5173
# 注册邮箱验证（true 时新用户需邮件激活才能登录）
# 邮箱验证开关已迁入应用配置体系：security.enableEmailVerification（admin 可改 / config.yaml 可覆盖）
# ENABLE_EMAIL_VERIFICATION=false

# ---- 邮件投递（MAIL_DELIVERY：log=日志投递（默认，零配置）| smtp=真实 SMTP 发信）----
# MAIL_DELIVERY=smtp 时下列 SMTP 键为必填（校验强制），仅 log 投递时可整段省略
MAIL_DELIVERY=log
SMTP_HOST=
# secure=true 走 465 隐式 TLS；587 端口请设 false（STARTTLS）
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# QQ 邮箱要求 SMTP_FROM 与认证账号一致，否则拒信
SMTP_FROM="ShareLink <no-reply@your-domain.com>"

# ---- 链接拼装（两套地址别混用）----
# 面向用户的页面基址：邮件内动作链接（重置密码 {FRONTEND_URL}/auth/resetPassword/{token}）、分享链接、反向上传链接
FRONTEND_URL=http://localhost:3001
# OAuth 回调基址：{APP_URL}/api/oauth/{provider}/callback，须与 IdP 后台登记的 redirect_uri 完全一致
APP_URL=http://localhost:3000

# ---- OAuth 第三方登录（GitHub OAuth App：凭证在 github.com/settings/developers 创建）----
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# 本地/自建 OIDC（scripts/mock-oidp.mjs 默认值即如下；生产可指向自建 Keycloak）
OAUTH_LOCAL_ISSUER=http://localhost:9099
OAUTH_LOCAL_CLIENT_ID=local-client
OAUTH_LOCAL_CLIENT_SECRET=local-secret
# 本地回归时指向 mock：OAUTH_GITHUB_AUTH_BASE/API_BASE=http://localhost:9099（不设回落官方域名）

# ---- 数据库（DATABASE_URL 由这五键在启动时派生，勿在文件里另写 DATABASE_URL）----
DB_HOST=localhost
# 宿主机端口默认 3307（本地若另装 MySQL 服务占 3306 时避免冲突；容器内仍是 3306）
DB_PORT=3307
DB_USER=root
DB_PASS=数据库密码
DB_NAME=数据库名字

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 密码，未设置则留空
REDIS_PASSWORD=

# ---- ClamAV 病毒扫描（clamd INSTREAM）----
# docker 部署默认服务名 clamav 无需配置；宿主机跑后端时改 localhost 并映射容器端口
#CLAMAV_HOST=localhost
#CLAMAV_PORT=3310

# ---- MinIO 对象存储（S3 兼容，开发预研）----
# docker-compose 的 minio 服务消费此凭证；S3 API http://localhost:9000（管理用容器自带 mc）
# 不启用预研容器时可整段省略（compose 里有同名默认值）
MINIO_ROOT_USER=sharelink
MINIO_ROOT_PASSWORD=sharelink2026

# ---- 文件存储驱动（local=本地磁盘默认 / s3=S3 兼容对象存储）----
# s3 时 ENDPOINT/BUCKET/ACCESS_KEY_ID/SECRET_ACCESS_KEY 条件必填（zod 启动校验拦截）
# 分块暂存与断点续传协议不受驱动影响（恒在本地磁盘），差异仅在"最后一块转正"之后
#STORAGE_DRIVER=local
#S3_ENDPOINT=http://localhost:9000
#S3_REGION=us-east-1
#S3_BUCKET=sharelink
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=true

# ---- 可选：分享文件磁盘根目录（默认 ./data）----
#DATA_DIRECTORY=./data

# ---- 日志级别语义（LOG_LEVEL）----
# 0 error   系统崩溃/致命故障（数据库连接失败、事务回滚异常）。需要程序员立即起床修。
# 1 warn    业务异常/可预见的错误（账号重复、ID不存在）。系统正常运行，但需要运营关注。
# 2 info    关键业务里程碑（新增员工成功、删除成功）。用于追踪正常业务流程。
# 3 http    （通常用于 HTTP 请求出入参，你的后台服务暂可不打）
# 4 verbose （较详细的日志，较少用）
# 5 debug   开发调试信息（临时工号生成、SQL 参数）。生产环境必须关闭。
# 6 silly   （极冗余信息，几乎不用）
