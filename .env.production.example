# ShareLink 生产环境变量模板
# 用法：cp .env.production.example .env 后逐键修改
# 此文件同时服务两个消费方：
#   1. docker-compose.yml 的变量替换（mysql/minio 服务消费 DB_PASS/DB_NAME/MINIO_ROOT_*）
#   2. backend 容器的 env_file（env-loader zod 校验后消费全部业务键）
# 安全提醒：本文件含密钥，绝不入库（.gitignore 已排除 .env）

# ============ 基础设施（compose 变量替换） ============
# MySQL root 密码 + 库名（生产请换强密码）
DB_PASS=change-me-strong-password
DB_NAME=sharelink
# MinIO 初始凭证（仅 compose 内网访问，也建议更换）
MINIO_ROOT_USER=sharelink
MINIO_ROOT_PASSWORD=sharelink2026
# 前端站点对外端口（宿主机）
WEB_PORT=80

# ============ 应用必填（env-loader 生产强校验） ============
# 会话/分享令牌签名密钥：至少 16 字符强随机值
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-strong-random-secret
# 生产必须 true：cookie 仅经 HTTPS 传输（需在 Caddy 前面有 TLS 终结，或给 Caddyfile 配 tls）
COOKIE_SECURE=true
# 跨域白名单（逗号分隔完整来源）。前后端同源部署（Caddy 反代 /api）时填站点自身地址即可
CORS_ORIGIN=https://your-domain.example.com
# 面向用户的页面地址（邮件内链接、OAuth 回跳拼装用）
FRONTEND_URL=https://your-domain.example.com
# OAuth 回调基址：{APP_URL}/api/oauth/{provider}/callback，须与 IdP 后台登记一致
APP_URL=https://your-domain.example.com

# ============ 数据库（容器内由 compose environment 映射为服务名，勿改 HOST/PORT） ============
DB_USER=root
#REDIS_PASSWORD=

# ============ 邮件投递 ============
# log=日志投递（默认，零配置联调）；smtp=真实 SMTP
MAIL_DELIVERY=log
# MAIL_DELIVERY=smtp 时以下五键必填（QQ 邮箱示例，SMTP_PASS 用授权码）
#SMTP_HOST=smtp.qq.com
#SMTP_PORT=465
#SMTP_SECURE=true
#SMTP_USER=you@qq.com
#SMTP_PASS=your-auth-code
#SMTP_FROM="ShareLink <you@qq.com>"

# ============ OAuth（不配则对应登录方式不可用） ============
#OAUTH_GITHUB_CLIENT_ID=
#OAUTH_GITHUB_CLIENT_SECRET=

# ============ 文件存储驱动 ============
# local=本地磁盘（backend_data 卷）；s3=任意 S3 兼容服务（下方 S3 凭证条件必填）
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3 时必填四键（S3_ENDPOINT/REGION 由 compose 注入容器内地址，勿在此覆盖）
#S3_BUCKET=sharelink
#S3_ACCESS_KEY_ID=sharelink
#S3_SECRET_ACCESS_KEY=sharelink2026
# 直传专用（方案 B，仅 s3 驱动）：预签名 URL 绑定 Host——必须是「浏览器可达」的端点；
# compose 里 S3_ENDPOINT 是容器内网名（http://minio:9000）浏览器到不了，
# 必须另配一个暴露给浏览器的地址（如 http://<服务器IP或域名>:9000 或反代路径）
#S3_PUBLIC_ENDPOINT=http://your-server:9000
# 预签名 URL 有效期秒数，默认 86400（24h）
#S3_DIRECT_URL_EXPIRES=86400

# ============ 日志 ============
LOG_LEVEL=info
